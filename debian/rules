#!/usr/bin/make -f
# -*- makefile -*-
# ROS 2 (bloom-style) Debian packaging for xsens_mti_ros2_driver.

export DH_VERBOSE=1
export LDFLAGS=
export PKG_CONFIG_PATH=/opt/ros/jazzy/lib/pkgconfig
export DEB_CXXFLAGS_MAINT_APPEND=-DNDEBUG

ifneq ($(filter nocheck,$(DEB_BUILD_OPTIONS)),)
	BUILD_TESTING_ARG=-DBUILD_TESTING=OFF
endif

DEB_HOST_GNU_TYPE ?= $(shell dpkg-architecture -qDEB_HOST_GNU_TYPE)

# The driver's CMake project lives here in this repository layout.
SRC_DIR := src/xsens_mti_ros2_driver

%:
	dh $@ -v --buildsystem=cmake \
		--sourcedirectory=$(SRC_DIR) \
		--builddirectory=.obj-$(DEB_HOST_GNU_TYPE)

override_dh_auto_configure:
	# Source the ROS setup so CMAKE_PREFIX_PATH/AMENT_PREFIX_PATH are set.
	if [ -f "/opt/ros/jazzy/setup.sh" ]; then . "/opt/ros/jazzy/setup.sh"; fi && \
	dh_auto_configure -- \
		-DCMAKE_INSTALL_PREFIX="/opt/ros/jazzy" \
		-DAMENT_PREFIX_PATH="/opt/ros/jazzy" \
		-DCMAKE_PREFIX_PATH="/opt/ros/jazzy" \
		$(BUILD_TESTING_ARG)

override_dh_auto_build:
	if [ -f "/opt/ros/jazzy/setup.sh" ]; then . "/opt/ros/jazzy/setup.sh"; fi && \
	dh_auto_build

override_dh_auto_test:
	echo -- Running tests. Even if one of them fails the build is not canceled.
	if [ -f "/opt/ros/jazzy/setup.sh" ]; then . "/opt/ros/jazzy/setup.sh"; fi && \
	dh_auto_test || true

override_dh_shlibdeps:
	if [ -f "/opt/ros/jazzy/setup.sh" ]; then . "/opt/ros/jazzy/setup.sh"; fi && \
	dh_shlibdeps -l$(CURDIR)/debian/ros-jazzy-xsens-mti-ros2-driver/opt/ros/jazzy/lib/

override_dh_auto_install:
	if [ -f "/opt/ros/jazzy/setup.sh" ]; then . "/opt/ros/jazzy/setup.sh"; fi && \
	dh_auto_install
