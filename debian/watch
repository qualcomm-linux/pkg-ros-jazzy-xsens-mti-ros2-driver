version=4

# Upstream publishes no release tarballs or tags; development happens on the
# ros2 branch. Track that branch in git mode so uscan derives a snapshot
# version (matching the upstream/0.0+gitYYYYMMDD.<sha> tag convention).
opts="mode=git, pgpmode=none, \
gitexport=all, \
uversionmangle=s/(\d{8})/0.0+git$1/" \
  https://github.com/xsenssupport/Xsens_MTi_ROS_Driver_and_Ntrip_Client.git \
  refs/heads/ros2
